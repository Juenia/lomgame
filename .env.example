# 机器人接入配置模板
#
# ─────────────────────────────────────────────────────────────────────
# 先挑一条通道（M2.77）—— 三条路的业务行为完全一样，差别只在「怎么接 QQ」
#
#   ADAPTER=onebot + ONEBOT_WS_URL=ws://…   内置正向 WS（推荐）
#       游戏自己连协议端。只需填一个地址，本机不用对协议端暴露端口，
#       断线自动重连。协议端（NapCat / LLOneBot / Lagrange）仍要你自己运行 ——
#       内置的是**连接层**，不是 QQ 协议本身。
#
#   ADAPTER=onebot（不填 ONEBOT_WS_URL）     反向 HTTP 上报（老路）
#       协议端把事件 POST 到本机；发送走协议端的 HTTP API。老部署照常跑，行为一字不变。
#
#   ADAPTER=qq                               QQ 官方机器人（QQ 开放平台）
#       走官方协议，不依赖 QQ 客户端，但需要开放平台的机器人资质。
#       填下面的 QQ_BOT_APPID / QQ_BOT_SECRET。
# ─────────────────────────────────────────────────────────────────────
# 环境要求：Node >= 22.18（根目录的 启动.ps1 会自动检查这一条）
#
# 用法：复制成 .env 再填真值
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，**绝不提交**。
# AppSecret 只写进 .env —— 不进代码、不进文档、不进任何 .md。

# 开放平台 → 机器人 → 开发设置 → AppID（纯数字）
QQ_BOT_APPID=

# 开放平台 → 机器人 → 开发设置 → AppSecret
# 泄露过的密钥必须去开放平台重置，重置后把新值写在这里
QQ_BOT_SECRET=

# 环境开关：1 = 沙箱（sandbox.api.sgroup.qq.com），0 = 正式（api.sgroup.qq.com）
# 事件不推时先切另一个试 —— 只有「群已加进沙箱」的那个环境才会推 GROUP_AT_MESSAGE_CREATE
QQ_BOT_SANDBOX=0

# 可选：机器人被 @ 前的前缀无关；这里只控制日志详细程度（1 = 打印完整事件 payload）
QQ_BOT_DEBUG=0

# 可选：正文走 Markdown（msg_type=2）。**官方通道只有 markdown 才能显示图片**
# （图片是正文里的一行 `![alt #宽px #高px](url)`；纯文本模式下无处可挂）。
# 开了它，`.卡` 才会走发图分支；没开就回落文字卡 + 本地文件路径。
QQ_BOT_MARKDOWN=0

# 管理后台（M2.49）—— 浏览器打开 http://127.0.0.1:3100/admin
#
# 后台能改玩家数值、能改上面那个 AppSecret，所以必须有口令，**别留空上线**。
# 不填的话每次启动会当场生成一个随机口令打进日志（重启就换，适合临时看看）。
# 口令也可以在后台「服务与访问」那一屏改 —— 改完立刻生效，不用重启。
ADMIN_PASSWORD=

# 监听地址（M2.82）
#
# 不填 = Node 的默认行为：绑**所有网卡**（0.0.0.0），也就是本机 + 局域网，
# 路由器放行的话还包括公网。想只让本机用，就填 127.0.0.1。
# 改完必须重启进程才生效（listen 已经绑上了，热改不了）。
# 后台的「服务与访问」那一屏会把「现在从哪些地址进得来」直接列出来。
# HOST=127.0.0.1

# 信任反向代理（M2.82）—— 前面有自己配的反代（nginx / caddy / 内网穿透）时才开
#
# 开了才认 X-Forwarded-For 里的来访 IP：审计日志与登录限流按真实客户端记账。
# 不开，日志里记的是代理自己的地址（127.0.0.1），所有人看起来都来自同一个来源。
# ⚠️ 乱开更糟：那个头谁都能伪造，等于让来访者自己填日志里的来源，
# 顺带让限流每次换个头就绕过去。
# TRUST_PROXY=1

# 运维接口令牌（可选）—— POST /admin/tick 这类端点的 x-admin-token
#
# 给脚本和压测工具用，不是给浏览器的。不填就退回上面那个 ONEBOT_TOKEN。
# 也可以在后台「服务与访问」那一屏改（改完要重启）。
# ADMIN_TOKEN=

# 角色卡图片（M2.47）
#
# 官方 markdown 的图片要求「可在公网访问的资源 url」，平台会下载转存 —— 
# 而卡是本地 PowerShell 画出来的。所以：
#   1. 服务会把出图目录挂在 `GET /cards/<文件名>.png`（见 startHttpServer）；
#   2. 你需要把这个地址暴露到公网（反代 / 内网穿透 / 同机公网 IP），填在下面。
# 不填也能用：`.卡` 只回文字卡 + 本地文件路径，不会报错。
CARD_PUBLIC_BASE_URL=
# 出图目录（默认 data/cards，已被 .gitignore 的 /data/ 覆盖）
CARD_OUT_DIR=

# 兜底：临时图床（**默认关**，只在没配 CARD_PUBLIC_BASE_URL 时生效）
#
# 填 uguu = 把卡图 POST 给 uguu.se 换一个公网 URL。本机实测可用
# （0x0.st 已停用上传、catbox / tmpfiles 在本机网络下无响应）。
#
# ⚠️ 两个代价，自己权衡：
#   1. **卡面会交给第三方**（含角色名与游戏数值）—— 自建托管没有这个问题；
#   2. 临时图床的链接会过期。官方会下载转存，所以群里显示的是平台自己那份；
#      但如果真机出现「图过一会儿裂了」，说明没转存 —— 那时请改用 CARD_PUBLIC_BASE_URL。
CARD_IMAGE_UPLOAD=

# ═════════════════════════════════════════════════════════════════════
# OneBot 通道（M2.77）
# ═════════════════════════════════════════════════════════════════════

# 通道开关（M2.79）：onebot（默认）/ qq / **both（两条一起开）**
#
#   both = 官方机器人与 OneBot 同时在线，消息进同一个世界、同一份数据库。
#   一条通道登录失败**不会**拖垮另一条（只有 QQ_BOT_STRICT_LOGIN=1 时才会）。
#
#   ⚠️ 同一个人在两条通道里目前是**两个角色**（QQ 号与 openid 不是一回事），
#      账号打通要单独做绑定 —— 这一轮做的是「两个入口、同一个世界」。
ADAPTER=onebot

# 多通道时，「主动推送」到一个从没收到过消息的会话走哪条通道（默认 onebot）
# 只有 both 模式用得上；这个数在 /health 的适配器和后台面板上都能看到 unrouted 计数
CHANNEL_DEFAULT=onebot

# 内置正向 WebSocket —— 填了就生效（推荐）
#
# 填协议端（NapCat / LLOneBot / Lagrange）的「正向 WebSocket 服务器」地址：
#   · 事件从这条连接进来，发送也从这条连接出去；
#   · 本机不用再对协议端暴露 HTTP 端口；
#   · 断线自动重连（指数退避），连接状态见 GET /health 的 onebot 段。
#
# ⚠️ 内建 WebSocket 不能自定义请求头（标准 API 限制），所以 token 走 query 参数：
#    协议端那边要求 token 时，这里直接填，游戏会拼成 ?access_token=…
ONEBOT_WS_URL=
ONEBOT_WS_TOKEN=

# 反向 HTTP 上报（老路，仅在 ONEBOT_WS_URL 留空时生效）
#
# 协议端的「上报地址」指向 http://<本机>:<PORT>/onebot/event，
# 这里填协议端的 HTTP API 基址（发送走它）。
ONEBOT_API_BASE=http://127.0.0.1:3000
ONEBOT_TOKEN=
