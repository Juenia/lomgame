# bridge-api（无适配器 / 纯 API 版）—— 复制成 bridge-api/.env 后按需改
#
# 与根目录 .env 的关系：两边都会被读，**进程里已经有的环境变量优先**，
# 然后是 bridge-api/.env，最后是根 .env（见 src/main.ts 的 loadEnvFiles）。

# 监听地址。默认 127.0.0.1（只服务本机）。
# ⚠️ 改成 0.0.0.0 之前先把 BRIDGE_TOKEN 设上 —— 这个接口能改玩家存档。
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3200

# 接口口令。没设 = 只接受本机请求（不是"不校验"，是"非本机一律 401"）。
BRIDGE_TOKEN=

# 游戏库。默认 data/bridge.db（与现有版本的库分开，避免两个进程锁同一个文件）。
# 想让两个版本共用同一个世界时再显式指过去 —— 但同一时刻只许跑一个。
# BRIDGE_DB_PATH=data/bridge.db

# 出站队列容量：超出会挤掉最旧的，并在响应里报 gap。
BRIDGE_OUTBOX_CAPACITY=500

# 图片怎么交给上游：
#   base64（默认，谁都能用）| url（最省流量，要求上游能访问那个 URL）| both
BRIDGE_IMAGE_MODE=base64

# 长轮询最多挂多久（毫秒）。
BRIDGE_LONGPOLL_MS=25000

# 单张图的字节上限；超了只告警，不丢图。
# BRIDGE_MAX_IMAGE_KB=4096

# 全局缺省能力（逗号分隔）：buttons,images,inline,richtext
# 上游可以用 POST /api/v1/capabilities 单独声明，那比这里更具体、优先级更高。
BRIDGE_CAPS=

# 头像直链模板（{userId} / {size} 是占位符）。不填 = 不出头像，卡片退回首字纹章。
# QQ 号直连的框架用这个：
# BRIDGE_AVATAR_TEMPLATE=https://q1.qlogo.cn/g?b=qq&nk={userId}&s={size}
BRIDGE_AVATAR_TEMPLATE=

# 后台口令（与现有版本共用同一个变量；不设则启动时随机生成并打进日志）
# ADMIN_PASSWORD=
